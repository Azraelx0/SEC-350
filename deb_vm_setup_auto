!/bin/bash
# This script will automate the setup of a linux vm 
# note this script is work in progress and not complete/tested yet

# Prompt for username
read -p "Enter the new user's username: " USERNAME

# Prompt for password (silent)
read -sp "Enter the password for the new user: " PASSWORD
echo

useradd -m -c "$FULL_NAME" "$USERNAME"

# option for adding user to sudoers group
read -p "Do you want to add $USERNAME to sudoers group? (y/n): " choice

# Check the user's input
if [ "$choice" = "y" ]; then
    sudo usermod -aG $USERNAME
if [ "$choice" = "y" ]; then
    break
else
    echo "Exiting."
    exit 0
fi


# Change hostname
read -p "Enter the new hostname: " NEW_HOSTNAME
hostname "$NEW_HOSTNAME"


# can be used if internet can be reached from machine
# network configuration using netplan
# config file should be in /etc/netplan/50-cloud-init.yaml

NIC=$(ip -o link show | awk -F': ' '{print $2}' | grep -v lo | head -n 1)
read -p "Enter IP with cidr (e.g., 192.168.1.10/24): " IP
read -p "Enter Gateway: " GW
read -p "Enter DNS (e.g., 8.8.8.8): " DNS
read -p "Add static route? (y/n): " ADD_ROUTE

ROUTE_CONFIG=""
if [[ "$ADD_ROUTE" == "y" ]]; then
    read -p "Enter destination network in CIDR (e.g., 0.0.0.0/0): " DEST_NET
    read -p "Enter gateway for the static route: " ROUTE_GW
    ROUTE_CONFIG="
        - to: $DEST_NET via: $ROUTE_GW"
fi

# --- File Operations ---
CONFIG_FILE="/etc/netplan/99-automated-config.yaml"
# Create a backup of any existing config files
sudo cp /etc/netplan/*.yaml "/etc/netplan/backup_$(date +%Y%m%d%H%M)" 2>/dev/null
cat <<EOF | sudo tee /etc/netplan/50-cloud-init.yaml
network:
  version: 2
  renderer: networkd
  ethernets:
    $NIC:
      addresses: [$IP]
      gateway4: $GW
      nameservers:
        addresses: [$DNS]
EOF
sudo netplan apply

